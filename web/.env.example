# Base URL of the Laravel API (including the /api/v1 prefix).
# Matches apiPrefix in api/bootstrap/app.php. 8080 is nginx's host port per
# docker-compose.yml's APP_PORT (default 8080) — keep this in sync with that.
VITE_API_URL=http://localhost:8080/api/v1

# Bare parent domain; localhost tenant subdomains work automatically in development.
# Must match WORKSPACE_DOMAIN on the API. Production: supporthub.com.
VITE_WORKSPACE_DOMAIN=
VITE_WORKSPACE_PORT=

# Public site (shown on the landing, contact and legal pages).
# Without VITE_SUPPORT_EMAIL the contact links are simply hidden.
VITE_LEGAL_ENTITY=Your Company Ltd.
VITE_SUPPORT_EMAIL=support@example.com
